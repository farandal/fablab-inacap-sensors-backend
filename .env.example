# Supabase (usar service_role key SOLO en el backend, nunca en el Arduino/frontend)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Puerto local
PORT=3000

# Token global de respaldo (para pruebas rapidas de estudiantes)
API_TOKEN=cambia-este-token

# Tokens por sensor (opcional). Formato: sensor_id:token,sensor_id2:token2
SENSOR_TOKENS=arduino_r3_lab_1:token-lab-1,arduino_r3_lab_2:token-lab-2

# Limite de registros por bloque que acepta el backend (debe calzar con MAX_REGISTROS del sensor)
MAX_REGISTROS=50
